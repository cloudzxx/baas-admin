{
  "name": "baas-admin-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Dashboard for management baas-admin service",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 umi build",
    "build": "umi build",
    "docker-hub:build": "docker build  -f Dockerfile.hub -t  ant-design-pro ./",
    "docker-prod:build": "docker compose -f ./docker/docker-compose.yml build",
    "docker-prod:dev": "docker compose -f ./docker/docker-compose.yml up",
    "docker:build": "docker compose -f ./docker/docker-compose.dev.yml build",
    "docker:dev": "docker compose -f ./docker/docker-compose.dev.yml up",
    "docker:push": "yarn docker-hub:build && yarn docker:tag && docker push antdesign/ant-design-pro",
    "docker:tag": "docker tag ant-design-pro antdesign/ant-design-pro",
    "functions:build": "yarn run generateMock && netlify dev",
    "netlify:dev": "netlify dev",
    "generateMock": "node ./scripts/generateMock",
    "lint": "eslint --ext .js src mock tests && yarn lint:style && yarn lint:prettier",
    "lint-staged": "lint-staged",
    "lint-staged:js": "eslint --ext .js",
    "lint:fix": "eslint --fix --ext .js src mock tests && stylelint --fix 'src/**/*.less' --syntax less",
    "lint:prettier": "check-prettier lint",
    "lint:style": "stylelint 'src/**/*.less' --syntax less",
    "prettier": "node ./scripts/prettier.js",
    "site": "umi build && yarn run functions:build",
    "start": "cross-env PORT=8001 umi dev",
    "start:no-mock": "cross-env PORT=8002 MOCK=none umi dev",
    "test": "umi test",
    "test:all": "node ./tests/run-tests.js",
    "test:component": "umi test ./src/components",
    "tslint": "yarn tslint:fix",
    "tslint:fix": "tslint --fix 'src/**/*.ts*'"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint-staged"
    }
  },
  "lint-staged": {
    "**/*.less": "stylelint --syntax less",
    "**/*.{js,jsx}": "npm run lint-staged:js",
    "**/*.{js,ts,tsx,json,jsx,less}": [
      "node ./scripts/lint-prettier.js",
      "git add"
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ],
  "dependencies": {
    "@ant-design/icons": "^5.6.0",
    "@antv/data-set": "^0.10.1",
    "@babel/core": "^7.26.10",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@umijs/plugins": "^4.4.0",
    "antd": "^5.22.0",
    "bizcharts": "3.5.3",
    "bizcharts-plugin-slider": "^2.1.1-beta.1",
    "body-parser": "^2.0.0",
    "cello-paginator": "^1.0.1",
    "classnames": "^2.2.6",
    "enquire-js": "^0.2.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "express": "^5.1.0",
    "gg-editor": "^2.0.2",
    "lodash": "^4.17.11",
    "lodash-decorators": "^6.0.1",
    "memoize-one": "^5.0.0",
    "merge-umi-mock-data": "^1.0.0",
    "moment": "^2.24.0",
    "numeral": "^2.0.6",
    "nzh": "^1.0.4",
    "omit.js": "^1.0.0",
    "path-to-regexp": "^8.2.0",
    "prop-types": "^15.6.2",
    "qs": "^6.6.0",
    "react": "^18.3.1",
    "react-copy-to-clipboard": "^5.0.1",
    "react-dom": "^18.3.1",
    "react-fittext": "^1.0.0",
    "react-helmet": "^6.1.0",
    "react-redux": "^7.2.2",
    "redux": "^4.0.5",
    "resize-observer-polyfill": "^1.5.1",
    "umi": "^4.4.0",
    "umi-request": "^1.2.19",
    "validator": "^13.7.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.22.15",
    "@babel/preset-react": "^7.22.15",
    "@types/history": "^4.7.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@umijs/preset-react": "^1.2.2",
    "chalk": "^2.4.2",
    "check-prettier": "^1.0.1",
    "cross-env": "^5.2.0",
    "cross-port-killer": "^1.0.1",
    "eslint": "^8.53.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-babel": "^5.3.1",
    "eslint-plugin-compat": "^4.2.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-markdown": "^3.0.1",
    "eslint-plugin-react": "^7.33.2",
    "faker": "^4.1.0",
    "gh-pages": "^6.1.1",
    "glob": "^9.0.0",
    "husky": "^4.2.5",
    "jest-puppeteer": "^4.1.0",
    "jsdom-global": "^3.0.2",
    "lint-staged": "^11.0.0",
    "mockjs": "^1.0.1-beta3",
    "netlify-cli": "^16.0.0",
    "prettier": "^2.8.0",
    "serverless-http": "^2.0.1",
    "slash2": "^2.0.0",
    "stylelint": "^13.13.1",
    "stylelint-config-css-modules": "^1.3.0",
    "stylelint-config-prettier": "^5.0.0",
    "stylelint-config-rational-order": "^0.1.0",
    "stylelint-config-standard": "^18.2.0",
    "stylelint-declaration-block-no-ignored-properties": "^2.1.0",
    "stylelint-order": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "checkFiles": [
    "src/**/*.js*",
    "src/**/*.ts*",
    "src/**/*.less",
    "config/**/*.js*",
    "scripts/**/*.js"
  ],
  "resolutions": {
    "mockjs/commander": "^8.2.0",
    "glob": "^9.0.0"
  }
}
